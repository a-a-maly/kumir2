		<section>
			<title>cpolar</title>
			<funcsynopsis role="кумир">
				<funcsynopsisinfo><package>Комплексные числа</package></funcsynopsisinfo>
				<funcprototype>
					<funcdef>алг<type>компл</type><function>cpolar</function></funcdef>
					<paramdef>вещ<parameter>r</parameter></paramdef>
